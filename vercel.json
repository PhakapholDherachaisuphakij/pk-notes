{
  "buildCommand": "if [ -d \"frontend\" ]; then node generate_static_vault.js 2>/dev/null || true; cd frontend && npm install && npm run build; else npm install && npm run build; fi",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/vault/tree",
      "destination": "/api/tree"
    },
    {
      "source": "/api/tree",
      "destination": "/api/tree"
    },
    {
      "source": "/api/notes",
      "destination": "/api/notes"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    },
    {
      "source": "/api/ai/:path*",
      "destination": "/api/ai"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
